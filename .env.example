# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=your_secret_here
DEBUG=true

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=axiom
POSTGRES_PASSWORD=changeme
POSTGRES_DB=axiom
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Database ──────────────────────────────────────────────────────────────────
# Use host=db when running inside Docker Compose, host=localhost for local dev
DATABASE_URL=postgresql+asyncpg://axiom:changeme@db:5432/axiom
TEST_DATABASE_URL=postgresql+asyncpg://axiom:changeme@localhost:5432/axiom_test

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_key_here

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173
