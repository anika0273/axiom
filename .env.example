# ── Application ───────────────────────────────────────────────────────────────
# Set to "production" in prod — controls logging format, debug mode, etc.
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-64-char-random-string-in-production
DEBUG=false

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=axiom
POSTGRES_PASSWORD=changeme
POSTGRES_DB=axiom

# In docker-compose.prod.yml the postgres service is named "postgres".
# In docker-compose.yml (dev) the service is named "db".
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Database ──────────────────────────────────────────────────────────────────
# Production (docker-compose.prod.yml): host = postgres (service name)
DATABASE_URL=postgresql+asyncpg://axiom:changeme@postgres:5432/axiom

# Development (docker-compose.yml): host = db (service name)
# DATABASE_URL=postgresql+asyncpg://axiom:changeme@db:5432/axiom

# Local dev outside Docker (host = localhost, port mapped to 5434):
# DATABASE_URL=postgresql+asyncpg://axiom:changeme@localhost:5434/axiom

TEST_DATABASE_URL=postgresql+asyncpg://axiom:changeme@localhost:5434/axiom_test

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── CORS ──────────────────────────────────────────────────────────────────────
# Development: allow the Vite dev server.
# Production: set to your public domain (e.g. https://axiom.example.com).
ALLOWED_ORIGINS=http://localhost
